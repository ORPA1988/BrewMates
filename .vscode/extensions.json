{
  // Was BrewMates am Arbeitsplatz braucht. VS Code schlägt diese Liste
  // beim Öffnen des Ordners vor; installiert wird nichts von selbst.
  "recommendations": [
    // Kern: die App ist Flutter/Dart.
    "dart-code.dart-code",
    "dart-code.flutter",
    "usernamehw.errorlens",

    // Backend: die drei Edge Functions unter supabase/functions sind Deno,
    // config.toml ist TOML.
    "denoland.vscode-deno",
    "tamasfe.even-better-toml",

    // Auslieferung läuft über GitHub Actions, main ist geschützt (Regel E).
    "github.vscode-github-actions",
    "github.vscode-pull-request-github",
    "redhat.vscode-yaml",
    "eamodio.gitlens",

    // Doku ist Teil jeder Änderung (Regel F): 76 Markdown-Dateien,
    // deutsch, mit Mermaid-Diagrammen in docs/03, 04, 05, 08, 09.
    "davidanson.vscode-markdownlint",
    "bierner.markdown-mermaid",
    "streetsidesoftware.code-spell-checker",
    "streetsidesoftware.code-spell-checker-german",

    // tools/*.py pflegen die Community-Datenbestände.
    "ms-python.python",
    "ms-python.vscode-pylance",

    // Testen: Die CI misst die Abdeckung und hält sie mit einer Ratsche
    // (--min 32) unten fest — aber sie meldet nur eine Zahl. Coverage
    // Gutters färbt die ungeprüften Zeilen im Editor ein, nachdem der
    // Task „Tests mit Abdeckung" gelaufen ist.
    "ryanluker.vscode-coverage-gutters",

    // Oberfläche: `core/theme.dart` beschreibt die Palette „Abend in der
    // Bar" als Color(0xFFE8A33D) & Co. Ohne Vorschau rät man, welcher
    // Bernstein gemeint ist; diese Erweiterung legt die Farbfläche
    // daneben und macht sie anklickbar.
    "circlecodesolution.ccs-flutter-color"
  ],

  // Beansprucht .dart-Dateien und kollidiert mit dart-code.
  "unwantedRecommendations": [
    "ms-vscode.cpptools-extension-pack"
  ]
}
